# Copy this file to `.env` and replace the placeholders with real values.

# PostgreSQL connection string (requires PostgreSQL >= 15)
DATABASE_URL="postgresql://user:password@localhost:5432/off_records"

# Required: at least 32 random bytes. Generate with:
# node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-me"
